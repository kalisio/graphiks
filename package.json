{
  "name": "@kalisio/graphiks",
  "version": "0.1.0",
  "description": "Factory de formes paramétriques en JavaScript pur",
  "main": "dist/graphiks.umd.js",
  "module": "dist/graphiks.es.js",
  "type": "module",
  "keywords": [
    "graphics",
    "SVG",
    "shape"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/kalisio/graphiks.git"
  },
  "author": {
    "name": "Kalisio contributors",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "bugs": {
    "url": "https://github.com/kalisio/graphiks/issues"
  },
  "exports": {
    ".": {
      "import": "./dist/graphiks.es.js",
      "require": "./dist/graphiks.umd.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "lint": "standard --fix",
    "mocha": "cross-env NODE_CONFIG_DIR=./test/config/ mocha --exit --timeout 30000",
    "coverage": "c8 npm run mocha",
    "test": "npm run lint && npm run coverage"
  },
  "standard": {
    "parserOptions": {
      "sourceType": "module"
    },
    "env": [
      "mocha"
    ],
    "globals": [
      "Vue",
      "Image"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "mocha": "^11.7.5",
    "standard": "^17.1.2",
    "vite": "^7.1.9"
  }
}
